{
  "info": {
    "name": "Campus Events - Phase 3 Full API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "adminToken", "value": "" },
    { "key": "student1Token", "value": "" },
    { "key": "student2Token", "value": "" },
    { "key": "eventId", "value": "" },
    { "key": "cap1EventId", "value": "" },
    { "key": "reg1Id", "value": "" },
    { "key": "cap1Reg1Id", "value": "" },
    { "key": "cap1Reg2Id", "value": "" }
  ],
  "item": [
    {
      "name": "0a. Login Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.collectionVariables.set('adminToken', pm.response.json().token);"],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@campus.edu\",\"password\":\"Admin@1234\"}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "0b. Register/Login Student 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.collectionVariables.set('student1Token', pm.response.json().token);"],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Student One\",\"email\":\"student1@campus.edu\",\"password\":\"Password1\"}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "0c. Register Student 2",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.collectionVariables.set('student2Token', pm.response.json().token);"],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Student Two\",\"email\":\"student2@campus.edu\",\"password\":\"Password1\"}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "1. Create Event Past Date (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Past Event\",\"description\":\"Testing past date validation\",\"date\":\"2020-01-01T10:00:00.000Z\",\"registrationDeadline\":\"2019-12-25T10:00:00.000Z\",\"capacity\":20}"
        },
        "url": "{{baseUrl}}/events"
      }
    },
    {
      "name": "2. Create Event Capacity 0 (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Zero Cap Event\",\"description\":\"Testing zero capacity validation\",\"date\":\"2027-05-10T10:00:00.000Z\",\"registrationDeadline\":\"2027-05-05T10:00:00.000Z\",\"capacity\":0}"
        },
        "url": "{{baseUrl}}/events"
      }
    },
    {
      "name": "3. Create Valid Event (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.collectionVariables.set('eventId', pm.response.json().event._id);"],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Tech Symposium 2027\",\"description\":\"Annual campus coding and robotics showcase.\",\"date\":\"2027-05-10T10:00:00.000Z\",\"registrationDeadline\":\"2027-05-05T10:00:00.000Z\",\"capacity\":50}"
        },
        "url": "{{baseUrl}}/events"
      }
    },
    {
      "name": "4. List Events (200)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/events"
      }
    },
    {
      "name": "5. Student 1 Registers (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.collectionVariables.set('reg1Id', pm.response.json().registration._id);"],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{student1Token}}" }],
        "url": "{{baseUrl}}/events/{{eventId}}/register"
      }
    },
    {
      "name": "6. Student 1 Registers Again (409)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{student1Token}}" }],
        "url": "{{baseUrl}}/events/{{eventId}}/register"
      }
    },
    {
      "name": "7. Student Calls Admin Route (403)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{student1Token}}" }],
        "url": "{{baseUrl}}/events/{{eventId}}/registrations"
      }
    },
    {
      "name": "8. Admin Approves Registration (200)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"status\":\"approved\"}" },
        "url": "{{baseUrl}}/registrations/{{reg1Id}}"
      }
    },
    {
      "name": "9. Admin Approves Again (409)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"status\":\"approved\"}" },
        "url": "{{baseUrl}}/registrations/{{reg1Id}}"
      }
    },
    {
      "name": "10a. Create Capacity 1 Event (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.collectionVariables.set('cap1EventId', pm.response.json().event._id);"],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"VIP Workshop\",\"description\":\"Exclusive single-seat workshop test.\",\"date\":\"2027-06-01T10:00:00.000Z\",\"registrationDeadline\":\"2027-05-25T10:00:00.000Z\",\"capacity\":1}"
        },
        "url": "{{baseUrl}}/events"
      }
    },
    {
      "name": "10b. Student 1 Registers for Cap 1 (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.collectionVariables.set('cap1Reg1Id', pm.response.json().registration._id);"],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{student1Token}}" }],
        "url": "{{baseUrl}}/events/{{cap1EventId}}/register"
      }
    },
    {
      "name": "10c. Student 2 Registers for Cap 1 (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.collectionVariables.set('cap1Reg2Id', pm.response.json().registration._id);"],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{student2Token}}" }],
        "url": "{{baseUrl}}/events/{{cap1EventId}}/register"
      }
    },
    {
      "name": "10d. Admin Approves Student 1 (200)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"status\":\"approved\"}" },
        "url": "{{baseUrl}}/registrations/{{cap1Reg1Id}}"
      }
    },
    {
      "name": "10e. Admin Approves Student 2 -> Full (409)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"status\":\"approved\"}" },
        "url": "{{baseUrl}}/registrations/{{cap1Reg2Id}}"
      }
    }
  ]
}