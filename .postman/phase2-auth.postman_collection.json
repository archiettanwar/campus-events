{
  "info": {
    "name": "Campus Events - Phase 2 Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "studentToken", "value": "" },
    { "key": "adminToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. Register Student (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.token) pm.collectionVariables.set('studentToken', res.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alex Student\",\n  \"email\": \"alex@campus.edu\",\n  \"password\": \"Password1\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "2. Register Duplicate Email (409)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alex Student\",\n  \"email\": \"alex@campus.edu\",\n  \"password\": \"Password1\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "3. Login Wrong Password (401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alex@campus.edu\",\n  \"password\": \"WrongPassword1\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "4. Login Admin (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.token) pm.collectionVariables.set('adminToken', res.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@campus.edu\",\n  \"password\": \"Admin@1234\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "5. Get Me - No Header (401)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auth/me"
      }
    },
    {
      "name": "6. Get Me - Bad Token (401)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer badtoken123" }],
        "url": "{{baseUrl}}/auth/me"
      }
    },
    {
      "name": "7. Get Me - Valid Student Token (200)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
        "url": "{{baseUrl}}/auth/me"
      }
    }
  ]
}